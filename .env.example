# LogiAgent Environment Configuration

# OpenAI API Key (Optional: if not provided, LogiAgent runs in autonomous deterministic simulation mode)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///data/logiagent.db

# Carrier Default Speed (km/h)
DEFAULT_SPEED_KMH=65.0
